# ==============================================================================
# StormGate Profile Service - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the actual values for your environment
# DO NOT commit .env file to version control
# ==============================================================================

# Application Configuration
SPRING_APPLICATION_NAME=profile-service
SERVER_PORT=8082

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://stormgate-db:3306/profile_service?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=stormgate
SPRING_DATASOURCE_PASSWORD=StormGate@2025
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Mail Configuration
# For development with MailHog, use mailhog as host
# For production, use your SMTP server (e.g., smtp.gmail.com)
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=testuser@mailhog.local
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# JWT Configuration
JWT_SECRET=acfddd580c0caa2e.2cad8b560cec782369e73960d0089949d314ba4ac0062ba803ce.9201b0da1a80781b7815dc0f99f3e745a66a795db6cda91324f7a055691a5ab689.cfd488e42439ff75a98ccc74a3813662ba45f07deaa5fb05c64a795df76be7d1030.aa5259ae5a7e97d8fbe38a7cd185e59c5ec654aabd70374c4f64e8f5908fe2cf1617bb.6dfb923b98d48f14051f9c4560a2c10a146a1d82fac2651978e0c60786442073682e0626.f7de03959df0429746ba70cce5ef8b941c75325efd64cbed76647881931334889b28c5ee5.e953d74b22a9e05f600157ee0ce541b4011f798bc02479ff19e696c5bbea62b002f12102d.16e10cd2edd4115c8a9a03b
